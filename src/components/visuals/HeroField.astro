<div class="hero-field" data-hero-field aria-hidden="true">
  <canvas data-hero-canvas></canvas>
</div>

<script>
  type Point = {
    x: number;
    y: number;
    z: number;
    radius: number;
    opacity: number;
    accent: boolean;
  };

  const field = document.querySelector<HTMLElement>("[data-hero-field]");
  const canvas = field?.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const context = canvas?.getContext("2d");

  if (field && canvas && context) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const compactViewport = window.matchMedia("(max-width: 639px)");
    const finePointer = window.matchMedia("(pointer: fine)");
    const animationDuration = 4_800;
    const targetFrameDuration = 1_000 / 30;

    let points: Point[] = [];
    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let animationFrame = 0;
    let animationStartedAt = 0;
    let previousFrameAt = 0;
    let isVisible = true;
    let pointerX = 0;
    let pointerY = 0;

    const random = (() => {
      let seed = 1612;

      return () => {
        seed = (seed * 1_664_525 + 1_013_904_223) % 4_294_967_296;
        return seed / 4_294_967_296;
      };
    })();

    const createPoints = () => {
      const count = compactViewport.matches ? 230 : 520;

      points = Array.from({ length: count }, () => ({
        x: (random() - 0.5) * 3.2,
        y: (random() - 0.5) * 2.2,
        z: (random() - 0.5) * 2.6,
        radius: 0.6 + random() * 1.05,
        opacity: 0.32 + random() * 0.62,
        accent: random() > 0.88,
      }));
    };

    const resize = () => {
      width = field.clientWidth;
      height = field.clientHeight;
      pixelRatio = Math.min(window.devicePixelRatio || 1, compactViewport.matches ? 1 : 1.5);
      canvas.width = Math.max(1, Math.floor(width * pixelRatio));
      canvas.height = Math.max(1, Math.floor(height * pixelRatio));
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      createPoints();
      draw(animationDuration);
    };

    const draw = (elapsed: number) => {
      context.clearRect(0, 0, width, height);
      const isLight = document.documentElement.classList.contains("light");
      const primaryColor = isLight ? "#4f4a45" : "#d8d5cf";
      const accentColor = isLight ? "#962f2b" : "#db7771";
      const themeOpacity = isLight ? 0.68 : 0.76;
      const viewportOpacity = compactViewport.matches ? 1.08 : 1;

      const progress = Math.min(elapsed / animationDuration, 1);
      const angle = progress * 0.12;
      const cos = Math.cos(angle);
      const sin = Math.sin(angle);
      const horizontalScale = Math.min(width, 1100) * 0.72;
      const verticalScale = Math.min(height, 900) * 0.72;

      for (const point of points) {
        const rotatedX = point.x * cos - point.z * sin + pointerX * 0.09;
        const rotatedZ = point.x * sin + point.z * cos;
        const depth = 3.2 + rotatedZ;
        const scale = 1 / depth;
        const x = width / 2 + rotatedX * horizontalScale * scale;
        const y = height / 2 + (point.y + pointerY * 0.06) * verticalScale * scale;

        if (x < -4 || x > width + 4 || y < -4 || y > height + 4) continue;

        context.fillStyle = point.accent ? accentColor : primaryColor;
        context.globalAlpha = Math.min(
          0.9,
          point.opacity * themeOpacity * viewportOpacity * (point.accent ? 1.12 : 1),
        );
        context.beginPath();
        context.arc(x, y, point.radius * Math.max(0.7, scale * 2.1), 0, Math.PI * 2);
        context.fill();
      }

      context.globalAlpha = 1;
    };

    const animate = (now: number) => {
      if (!isVisible || document.hidden || reducedMotion.matches) {
        animationFrame = 0;
        return;
      }

      if (now - previousFrameAt >= targetFrameDuration) {
        const elapsed = Math.min(now - animationStartedAt, animationDuration);
        draw(elapsed);
        previousFrameAt = now;
      }

      if (now - animationStartedAt < animationDuration) {
        animationFrame = window.requestAnimationFrame(animate);
      } else {
        animationFrame = 0;
      }
    };

    const start = () => {
      if (animationFrame || reducedMotion.matches || !isVisible || document.hidden) {
        draw(animationDuration);
        return;
      }

      animationStartedAt = performance.now();
      previousFrameAt = 0;
      animationFrame = window.requestAnimationFrame(animate);
    };

    const redrawStatic = () => {
      if (!animationFrame) draw(animationDuration);
    };

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;

      if (!isVisible && animationFrame) {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }
    });

    const themeObserver = new MutationObserver(redrawStatic);
    const resizeObserver = new ResizeObserver(resize);

    visibilityObserver.observe(field);
    resizeObserver.observe(field);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });

    if (finePointer.matches) {
      field.parentElement?.addEventListener(
        "pointermove",
        (event) => {
          const bounds = field.getBoundingClientRect();
          pointerX = event.clientX / bounds.width - 0.5;
          pointerY = (event.clientY - bounds.top) / bounds.height - 0.5;
          redrawStatic();
        },
        { passive: true },
      );
    }

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) redrawStatic();
    });
    reducedMotion.addEventListener("change", redrawStatic);
    compactViewport.addEventListener("change", resize);

    resize();
    start();
  }
</script>
