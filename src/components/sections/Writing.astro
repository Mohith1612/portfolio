---
import { profile, writing } from "../../data/portfolio";

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T00:00:00Z`));
---

<section class="w-full py-24 px-6 md:px-0" id="writing">
  <div class="max-w-2xl mx-auto">
    <div class="mb-12 flex items-baseline justify-between gap-6">
      <h2 class="section-label">Writing</h2>
      <a class="text-link text-link--accent min-h-0 text-xs" href={profile.blog} target="_blank" rel="noreferrer">
        All writing ↗
      </a>
    </div>

    <ul class="space-y-6">
      {
        writing.map((item) => (
          <li>
            <a
              href={item.link}
              target="_blank"
              rel="noreferrer"
              class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 md:gap-4 group"
            >
              <h3 class="text-pretty text-lg text-muted-foreground transition-colors duration-200 group-hover:text-accent">
                {item.title}
              </h3>
              <time datetime={item.date} class="tabular-nums shrink-0 self-end font-mono text-xs text-muted-foreground md:self-auto">
                {formatDate(item.date)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
