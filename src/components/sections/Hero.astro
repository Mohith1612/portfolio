---
import HeroField from "../visuals/HeroField.astro";
import { profile } from "../../data/portfolio";
---

<section
  class="hero-section relative flex w-full flex-col items-center justify-center overflow-hidden"
>
  <HeroField />

  <div
    class="hero-copy z-10 max-w-4xl space-y-6 px-6 text-center"
  >
    <h1
      class="text-balance text-5xl font-semibold tracking-[-0.045em] text-foreground md:text-7xl"
    >
      {profile.name}
    </h1>
    <p
      class="text-balance mx-auto max-w-2xl text-xl font-light leading-relaxed text-muted-foreground md:text-2xl"
    >
      Backend and systems engineer building reliable software from storage
      primitives to production platforms.
    </p>
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">
      {profile.location} · Founding Engineer at SiteSmart India
    </p>

    <nav aria-label="Profile links" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1 pt-1">
      <a class="text-link text-link--accent" href={`mailto:${profile.email}`}>Email</a>
      <a class="text-link text-link--accent" href="/resume">Résumé</a>
      <a class="text-link text-link--accent" href={profile.github} target="_blank" rel="noreferrer">
        GitHub ↗
      </a>
    </nav>
  </div>

  <div class="hero-scroll-cue absolute bottom-10 text-muted-foreground" aria-hidden="true">
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
