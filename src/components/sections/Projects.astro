---
import { projects } from "../../data/portfolio";
---

<section class="w-full py-24 px-6 md:px-0" id="projects">
    <div class="max-w-3xl mx-auto">
        <h2 class="section-label mb-12">Selected Work</h2>

        <div class="flex flex-col space-y-0">
            {
                projects.map((project) => (
                    <article class="border-b border-border py-9">
                        <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4">
                            <div class="min-w-0 flex-1">
                                <h3 class="text-balance text-xl font-medium text-foreground">
                                    {project.caseStudy ? (
                                      <a class="transition-colors duration-200 hover:text-accent" href={project.caseStudy}>
                                        {project.title}
                                      </a>
                                    ) : project.title}
                                </h3>
                                <p class="text-pretty mt-2 max-w-lg text-muted-foreground">
                                    {project.description}
                                </p>
                                <p class="mt-3 font-mono text-xs text-muted-foreground">
                                    {project.tech}
                                </p>
                                <p class="mt-3 font-mono text-xs text-foreground">
                                  {project.proof}
                                </p>
                            </div>

                            <div class="flex flex-col items-start gap-1 md:items-end">
                                <div class="flex flex-wrap gap-x-5">
                                    {project.caseStudy && (
                                      <a href={project.caseStudy} class="text-link text-link--accent">
                                        Case study
                                      </a>
                                    )}
                                    {project.live && (
                                      <a href={project.live} target="_blank" rel="noreferrer" class="text-link text-link--accent">
                                        Live ↗
                                      </a>
                                    )}
                                    <a
                                        href={project.github}
                                        target="_blank"
                                        rel="noreferrer"
                                        class="text-link text-link--accent"
                                    >
                                        Source ↗
                                    </a>
                                </div>
                                <span class="tabular-nums font-mono text-xs text-muted-foreground">
                                    {project.period}
                                </span>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
