---
import { profile, publications } from "../../data/portfolio";
---

<section class="w-full py-24 px-6 md:px-0" id="research">
  <div class="max-w-3xl mx-auto">
    <div class="mb-12 flex items-baseline justify-between gap-6">
      <h2 class="section-label">
        Research
      </h2>
      <a href={profile.scholar} target="_blank" rel="noreferrer" class="text-xs text-muted-foreground hover:text-accent transition-colors">
        Google Scholar ↗
      </a>
    </div>

    <ol>
      {publications.map((publication, index) => (
        <li class="border-b border-border py-7">
          <a href={publication.link} target="_blank" rel="noreferrer" class="group grid gap-3 md:grid-cols-[2rem_1fr_auto] md:items-baseline">
            <span aria-hidden="true" class="font-mono text-xs text-muted-foreground">0{index + 1}</span>
            <h3 class="text-pretty leading-snug text-muted-foreground transition-colors duration-200 group-hover:text-accent">
              {publication.title}
            </h3>
            <span class="font-mono text-xs text-muted-foreground md:text-right">
              {publication.venue} · <time datetime={publication.year}>{publication.year}</time>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
