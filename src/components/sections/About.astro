---
import { aboutHeading, aboutSystemsParagraph, aboutWorkParagraph, educationLabel } from "@/data/site-copy";
import { education, skillGroups } from "@/data/portfolio";
---

<section class="w-full py-24 px-6 md:px-0" id="about">
  <div class="max-w-2xl mx-auto space-y-12">
    <h2 class="section-label mb-8">{aboutHeading}</h2>

    <div
      class="text-pretty space-y-5 text-lg leading-relaxed text-muted-foreground"
    >
      <p>
        {aboutSystemsParagraph}
      </p>
      <p>
        {aboutWorkParagraph}
      </p>
    </div>

    <dl class="grid gap-6 border-t border-border pt-8">
      {skillGroups.map((group) => (
        <div class="grid gap-2 md:grid-cols-[8rem_1fr] md:gap-6">
          <dt class="text-xs font-mono uppercase tracking-wider text-foreground">
            {group.label}
          </dt>
          <dd class="text-sm leading-relaxed text-muted-foreground">
            {group.items}
          </dd>
        </div>
      ))}
      <div class="grid gap-2 md:grid-cols-[8rem_1fr] md:gap-6">
        <dt class="text-xs font-mono uppercase tracking-wider text-foreground">{educationLabel}</dt>
        <dd class="text-sm leading-relaxed text-muted-foreground">
          {education[0].degree.replace("Bachelor of Technology", "B.Tech")} · {education[0].school} · 2025
        </dd>
      </div>
    </dl>
  </div>
</section>
