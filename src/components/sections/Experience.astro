---
import { experience } from "../../data/portfolio";
---

<section class="w-full py-24 px-6 md:px-0" id="experience">
    <div class="max-w-3xl mx-auto">
        <h2 class="section-label mb-12">Experience</h2>

        <div class="space-y-0">
            {
                experience.map((job) => (
                    <article class="grid gap-5 border-b border-border py-8 md:grid-cols-[1fr_auto]">
                        <div>
                          <div class="flex flex-col md:flex-row gap-2 md:gap-8 items-baseline">
                            <h3 class="text-lg font-medium text-foreground">
                              {job.company}
                            </h3>
                            <span class="text-sm text-muted-foreground">
                                {job.role}
                            </span>
                          </div>
                          <p class="text-pretty mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
                            {job.summary}
                          </p>
                          <p class="mt-3 font-mono text-xs text-muted-foreground">
                            {job.detail}
                          </p>
                          {job.proof && (
                            <p class="mt-3 font-mono text-xs text-foreground">
                              {job.proof}
                            </p>
                          )}
                        </div>
                        <span class="tabular-nums mt-2 font-mono text-xs text-muted-foreground md:mt-0">
                            {job.period}
                        </span>
                    </article>
                ))
            }
        </div>
    </div>
</section>
