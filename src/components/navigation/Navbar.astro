<nav class="site-nav" data-site-nav data-visible="false" aria-label="Primary navigation">
  <div class="flex items-center gap-4 rounded-full border border-border/80 bg-background/88 px-4 py-1 shadow-sm backdrop-blur-md md:gap-8 md:px-8">
    <a class="text-link min-h-10 text-xs font-medium uppercase tracking-wider" href="/#experience">
      Work
    </a>
    <a class="text-link min-h-10 text-xs font-medium uppercase tracking-wider" href="/#projects">
      Projects
    </a>
    <a class="text-link min-h-10 text-xs font-medium uppercase tracking-wider" href="/#open-source">
      OSS
    </a>
    <a class="text-link min-h-10 text-xs font-medium uppercase tracking-wider" href="/#writing">
      Writing
    </a>
  </div>
</nav>

<script>
  const navigation = document.querySelector<HTMLElement>("[data-site-nav]");

  if (navigation) {
    let ticking = false;

    const updateNavigation = () => {
      navigation.dataset.visible = String(window.scrollY > 100);
      ticking = false;
    };

    const requestNavigationUpdate = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateNavigation);
        ticking = true;
      }
    };

    updateNavigation();
    window.addEventListener("scroll", requestNavigationUpdate, { passive: true });
  }
</script>
