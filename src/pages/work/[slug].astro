---
import Footer from "../../components/sections/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import { caseStudies } from "../../data/portfolio";

export function getStaticPaths() {
  return caseStudies.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: (typeof caseStudies)[number];
};

const { project } = Astro.props;
---

<Layout
  title={`${project.title} — Mohith N`}
  description={`${project.description} Read the architecture decisions, failure handling, and measured outcomes.`}
  showNavigation={false}
>
  <article class="w-full px-6 pb-20 pt-28 md:px-0 md:pt-36">
    <header class="mx-auto max-w-3xl border-b border-border pb-14">
      <a class="text-link text-link--accent mb-10" href="/#projects">← Selected work</a>
      <p class="section-label mb-5">{project.eyebrow}</p>
      <h1 class="text-balance text-4xl font-semibold tracking-[-0.035em] md:text-6xl">
        {project.title}
      </h1>
      <p class="text-pretty mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        {project.description}
      </p>

      <dl class="mt-10 grid gap-6 border-t border-border pt-7 md:grid-cols-2">
        <div>
          <dt class="section-label">Stack</dt>
          <dd class="mt-2 font-mono text-xs leading-relaxed text-muted-foreground">{project.tech}</dd>
        </div>
        <div>
          <dt class="section-label">Evidence</dt>
          <dd class="mt-2 font-mono text-xs leading-relaxed text-foreground">{project.proof}</dd>
        </div>
      </dl>

      <nav aria-label="Project links" class="mt-6 flex flex-wrap gap-x-6">
        {project.live && (
          <a class="text-link text-link--accent" href={project.live} target="_blank" rel="noreferrer">Live system ↗</a>
        )}
        <a class="text-link text-link--accent" href={project.github} target="_blank" rel="noreferrer">Source code ↗</a>
      </nav>
    </header>

    <div class="mx-auto max-w-3xl">
      <section class="grid gap-5 border-b border-border py-16 md:grid-cols-[10rem_1fr] md:gap-12">
        <h2 class="section-label">The challenge</h2>
        <div class="space-y-5 text-pretty leading-relaxed text-muted-foreground">
          <p>{project.challenge}</p>
          <p>{project.intro}</p>
        </div>
      </section>

      <section class="border-b border-border py-16">
        <h2 class="section-label mb-10">Engineering decisions</h2>
        <ol class="grid gap-10">
          {project.decisions.map((decision, index) => (
            <li class="grid gap-4 md:grid-cols-[2rem_1fr] md:gap-8">
              <span aria-hidden="true" class="font-mono text-xs text-muted-foreground">0{index + 1}</span>
              <div>
                <h3 class="text-pretty text-lg font-medium leading-snug">{decision.text}</h3>
                <p class="text-pretty mt-3 leading-relaxed text-muted-foreground">{decision.impact}</p>
                {decision.metric && (
                  <p class="mt-3 font-mono text-xs leading-relaxed text-foreground">{decision.metric}</p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="py-16">
        <h2 class="section-label mb-10">Measured outcomes</h2>
        <ul class="grid gap-px overflow-hidden rounded-sm border border-border bg-border md:grid-cols-2">
          {project.outcomes.map((outcome) => (
            <li class="bg-background p-6 font-mono text-sm leading-relaxed text-foreground">
              {outcome}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>

  <Footer />
</Layout>
