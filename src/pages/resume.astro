---
import Layout from "../layouts/Layout.astro";
import {
  education,
  experience,
  openSource,
  profile,
  projects,
  publications,
  resumeData,
} from "../data/portfolio";

const topExperienceBullets = Object.fromEntries(
  resumeData.experience.map((job) => [job.id, job.bullets.slice(0, job.id === "exp-sitesmart" ? 5 : 3)]),
);
---

<Layout
  title="Résumé — Mohith N"
  description="Résumé of Mohith N, a backend and systems engineer based in Bangalore, India."
  showNavigation={false}
>
  <article class="resume-page w-full px-6 pb-20 pt-24 md:px-0 md:pt-28">
    <header class="mx-auto max-w-4xl border-b border-border pb-9">
      <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
        <div>
          <a class="text-link text-link--accent mb-6 print:hidden" href="/">← Portfolio</a>
          <h1 class="text-4xl font-semibold tracking-[-0.035em] md:text-5xl">{profile.name}</h1>
          <p class="mt-3 text-lg text-muted-foreground">Backend & Systems Engineer</p>
          <p class="mt-2 font-mono text-xs text-muted-foreground">{profile.location}</p>
        </div>

        <div class="flex flex-col items-start md:items-end">
          <button
            type="button"
            data-print-control
            class="mb-3 inline-flex min-h-11 items-center border-b border-border text-sm text-muted-foreground transition-colors duration-200 hover:border-accent hover:text-foreground print:hidden"
          >
            Print / Save PDF
          </button>
          <a class="text-link min-h-8" href={`mailto:${profile.email}`}>{profile.email}</a>
          <a class="text-link min-h-8" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
          <a class="text-link min-h-8" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-4xl">
      <section class="resume-section grid gap-7 border-b border-border py-10 md:grid-cols-[9rem_1fr] md:gap-12">
        <h2 class="section-label">Experience</h2>
        <div class="space-y-10">
          {experience.map((job) => (
            <article>
              <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between md:gap-6">
                <h3 class="text-lg font-medium">{job.role} · {job.company}</h3>
                <span class="tabular-nums shrink-0 font-mono text-xs text-muted-foreground">{job.period}</span>
              </div>
              <ul class="mt-4 list-disc space-y-2 pl-4 text-sm leading-relaxed text-muted-foreground marker:text-accent">
                {topExperienceBullets[job.id].map((bullet) => (
                  <li>
                    {bullet.text}{bullet.impact ? `; ${bullet.impact}` : ""}{bullet.metrics ? ` (${bullet.metrics})` : ""}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="resume-section grid gap-7 border-b border-border py-10 md:grid-cols-[9rem_1fr] md:gap-12">
        <h2 class="section-label">Selected work</h2>
        <div class="space-y-8">
          {projects.map((project) => (
            <article>
              <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between md:gap-6">
                <h3 class="font-medium">
                  <a class="transition-colors duration-200 hover:text-accent" href={project.github} target="_blank" rel="noreferrer">
                    {project.title}
                  </a>
                </h3>
                <span class="tabular-nums shrink-0 font-mono text-xs text-muted-foreground">{project.period}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
              <p class="mt-2 font-mono text-xs text-foreground">{project.proof}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="resume-section grid gap-7 border-b border-border py-10 md:grid-cols-[9rem_1fr] md:gap-12">
        <h2 class="section-label">Open source</h2>
        <div class="grid gap-6 md:grid-cols-2">
          {openSource.map((item) => (
            <article>
              <h3 class="font-medium">
                <a class="transition-colors duration-200 hover:text-accent" href={item.contributionLink} target="_blank" rel="noreferrer">
                  {item.project} · {item.contribution}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="resume-section grid gap-7 border-b border-border py-10 md:grid-cols-[9rem_1fr] md:gap-12">
        <h2 class="section-label">Research</h2>
        <ol class="space-y-4">
          {publications.map((publication) => (
            <li>
              <a class="text-sm leading-relaxed text-muted-foreground transition-colors duration-200 hover:text-accent" href={publication.link} target="_blank" rel="noreferrer">
                {publication.title} · {publication.venue}, {publication.year}
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="resume-section grid gap-7 py-10 md:grid-cols-[9rem_1fr] md:gap-12">
        <h2 class="section-label">Foundation</h2>
        <div class="space-y-6">
          <div>
            <h3 class="font-medium">Education</h3>
            <p class="mt-2 text-sm text-muted-foreground">
              {education[0].degree} · {education[0].school} · {education[0].dates}
            </p>
          </div>
          <div>
            <h3 class="font-medium">Technical range</h3>
            <dl class="mt-3 grid gap-2 text-sm text-muted-foreground">
              {resumeData.skills.map((group) => (
                <div class="grid gap-1 md:grid-cols-[10rem_1fr]">
                  <dt class="font-medium text-foreground">{group.category}</dt>
                  <dd>{group.items.join(", ")}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>
    </div>
  </article>
</Layout>

<script>
  document
    .querySelector<HTMLButtonElement>("[data-print-control]")
    ?.addEventListener("click", () => window.print());
</script>

<style>
  @media print {
    .resume-page {
      padding: 0 !important;
    }

    .resume-section {
      break-inside: avoid;
      padding-block: 1.1rem !important;
    }
  }
</style>
